# Cava (visualizador de audio) con degradado Neon Sunset. Uso: cava   (q para salir)
[general]
framerate = 60
bar_width = 2
bar_spacing = 1
sensitivity = 100

[input]
method = pipewire
source = auto

[output]
method = noncurses

[color]
gradient = 1
gradient_count = 5
gradient_color_1 = '#4DE8FF'
gradient_color_2 = '#6C8CFF'
gradient_color_3 = '#B44CFF'
gradient_color_4 = '#FF5CE1'
gradient_color_5 = '#FFA348'

[smoothing]
noise_reduction = 77
