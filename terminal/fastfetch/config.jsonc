// Fastfetch compacto (paleta Neon Sunset). Uso: fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "color": { "1": "magenta", "2": "cyan" }, "padding": { "right": 2 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "cyan" },
    "key": { "width": 9 }
  },
  "modules": [
    "title",
    { "type": "os",       "key": "os",      "format": "{name} {version-id}" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "de",       "key": "de" },
    { "type": "uptime",   "key": "uptime" },
    { "type": "packages", "key": "pkgs" },
    { "type": "cpu",      "key": "cpu",     "format": "{name}" },
    { "type": "gpu",      "key": "gpu",     "format": "{name}", "hideType": "discrete" },
    { "type": "memory",   "key": "ram" },
    { "type": "disk",     "key": "disk",    "folders": "/" },
    { "type": "battery",  "key": "bat" },
    "break",
    { "type": "colors",   "symbol": "circle" }
  ]
}
