#!/bin/bash
# Guarda la configuración de GNOME en ~/dotfiles y hace commit local.
# NO es un backup de tus datos: solo versiona la configuración.
set -euo pipefail
cd "$HOME/dotfiles"

# Solo las ramas de dconf que configuramos (no volcamos todo: puede contener
# rutas recientes y datos personales).
for p in /org/gnome/shell/extensions/dash-to-dock/ /org/gnome/shell/extensions/blur-my-shell/ \
         /org/gnome/desktop/wm/preferences/ /org/gnome/desktop/peripherals/touchpad/ \
         /org/gnome/mutter/; do
    f="gnome/dconf/$(echo "$p" | tr '/' '_' | sed 's/^_//;s/_$//').ini"
    mkdir -p gnome/dconf
    dconf dump "$p" > "$f"
done
gsettings get org.gnome.shell favorite-apps > gnome/dconf/favorite-apps.txt
gnome-extensions list --enabled > gnome/extensions.txt

git add -A
if git diff --cached --quiet; then
    echo "Sin cambios en la configuración."
else
    git commit -q -m "backup-config: $(date '+%F %H:%M')"
    echo "Configuración guardada (commit local). Súbela con: git -C ~/dotfiles push"
fi
